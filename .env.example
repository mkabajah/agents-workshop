# Copy to .env and fill in. Never commit .env.

# Where your RAG course repo is (it holds challenge/mcp_server.py) and which CVs it reads.
RAG_REPO=../rag-zero-to-agentic
# CV_DIR=../rag-zero-to-agentic/data/cvs/candidates    # default: the invented CVs
# RAG_EMBEDDER=tfidf                                     # offline: no MiniLM download

# The model, as provider:model. It must support tool calling.
MODEL=anthropic:claude-sonnet-4-6
# SMALL_MODEL=anthropic:claude-haiku-4-5                 # cheaper: summaries, the eval judge
ANTHROPIC_API_KEY=

# MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=

# Free, OpenAI-compatible (invented CVs only):
# MODEL=openai:openai/gpt-oss-20b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=

# Local and free (fine for real CVs): ollama pull qwen2.5:7b ; pip install langchain-ollama
# MODEL=ollama:qwen2.5:7b

# Offline, no key (tests, dry runs): a scripted stand-in, not an LLM
# MODEL=fake

# Tracing (session 2)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agents-workshop

# CrewAI uses LiteLLM names; leave empty to derive from MODEL
# CREW_LLM=anthropic/claude-sonnet-4-6
